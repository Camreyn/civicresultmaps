# Copy to tools/mattermost-bot/.env.local (already gitignored).
# Never paste tokens into chat, commits, screenshots, or command-line arguments.
MATTERMOST_URL=https://mattermost.example.org
MATTERMOST_BOT_TOKEN=
MATTERMOST_CHANNEL_ID=
MATTERMOST_CHANNEL_NAME=
# Optional comma-separated Mattermost user IDs; empty permits current channel members.
MATTERMOST_ALLOWED_USER_IDS=
MATTERMOST_POLL_MS=5000

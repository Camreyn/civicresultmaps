DATABASE_URL=
POSTGRES_URL=
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=
VERCEL_TOKEN=

# Equipment Explorer (local/preview review; production accepts only public)
EQUIPMENT_CATALOG_CHANNEL=staging
EQUIPMENT_EXPLORER_ENABLED=0
NEXT_PUBLIC_EQUIPMENT_EXPLORER=0

# Private workspace layout editor
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
UI_LAYOUT_ADMIN_EMAILS=
EDGE_CONFIG=
FLAGS_SECRET=
CRON_SECRET=
UI_LAYOUT_SCHEDULER_ENABLED=false

# Server-side workflow dispatch (keep disabled until main and protected environments are ready)
UI_LAYOUT_PUBLISH_WORKFLOW_ENABLED=false
UI_LAYOUT_GITHUB_TOKEN=
UI_LAYOUT_GITHUB_REPOSITORY=Camreyn/civicresultmaps
UI_LAYOUT_PUBLISH_REF=main

# Local-only deterministic editor harness; production always returns 404
UI_LAYOUT_TEST_HARNESS=false

# Protected GitHub environment secrets used by ui-layout-publish.yml
VERCEL_ACCESS_TOKEN=
VERCEL_EDGE_CONFIG_ID=
VERCEL_TEAM_ID=

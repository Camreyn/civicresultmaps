# Keep local/generated workspaces out of Vercel source uploads.
.git/
.next/
node_modules/
.vercel/
.etl/
.etl-test/
.tools/
.codex-remote-attachments/
/coverage/
tmp/
__pycache__/
**/__pycache__/
*.pyc
tsconfig.tsbuildinfo

# Never upload local secrets.
.env
.env.local
.env.*.local
.setup-token
.import-token

# The Next app imports only small registry files from data/ at runtime.
# Large raw election artifacts stay in GitHub/source storage and are not
# needed in Vercel deployment bundles.
data/**
!data/equipment-catalog.staging.json
!data/equipment-catalog.public.json
!data/equipment-usage-index.json
!data/admin-source-packages.json
!data/election-security-incident-source-inventory-2024.json
!data/election-security-incidents-2024.json
!data/canonical-jurisdictions.json
!data/county-historical-aliases.json
!data/electronic-integrity-artifacts.json
!data/electronic-integrity-received-files.json
!data/electronic-integrity-request-contacts.json
!data/electronic-integrity-request-operations.json
!data/electronic-integrity-request-tracker.json
!data/source-records-request-contacts.json
!data/source-records-request-operations.json
!data/source-records-request-received-files.json
!data/source-records-request-tracker.json
!data/source-records-request-email-drafts/
!data/source-records-request-email-drafts/**
!data/native-import-source-packages.json
!data/precinct-geometry-manifests.json
!data/national-data-releases.json
!data/source-acquisition-tiers.json
!data/swing-state-2024-parity-status.json
!data/turnout-source-packages.json
!data/wi-2024-audit-summary.json
!data/wi-2024-audit-selections.csv
!data/eac-2024-vote-methods/
!data/eac-2024-vote-methods/**
!data/district-compactness/
!data/district-compactness/district-compactness.json
